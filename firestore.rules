rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: true when the request comes from a signed-in user.
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: true when the signed-in user owns the document with this uid.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // User profiles: one document per Firebase Auth user, keyed by uid.
    match /users/{uid} {
      // Only the owner can read their own profile.
      allow read: if isOwner(uid);

      // The owner can create their own profile with a name, an email
      // and a role that is either "customer" or "merchant".
      allow create: if isOwner(uid)
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.role in ['customer', 'merchant'];

      // The owner can update their profile, but may not change their role.
      allow update: if isOwner(uid)
                    && request.resource.data.role == resource.data.role;

      // Profiles cannot be deleted from the client.
      allow delete: if false;
    }

    // Helper: true when the signed-in user has the role "merchant" in their profile.
    function isMerchant() {
      return isSignedIn()
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'merchant';
    }

    // Helper: true when the signed-in user has the role "customer" in their profile.
    function isCustomer() {
      return isSignedIn()
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'customer';
    }

    // Shops: one document per merchant, keyed by the uid of the merchant (shops/{uid}).
    match /shops/{shopId} {
      // Any signed-in user can see the shops (customers look for packages).
      allow read: if isSignedIn();

      // Only the merchant who owns the document can write it: the document id and the
      // ownerId must be their own uid, and the fields must have the right shape.
      allow create, update: if isMerchant()
                            && isOwner(shopId)
                            && request.resource.data.ownerId == request.auth.uid
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 60
                            && request.resource.data.category in ['bakker', 'supermarkt', 'restaurant']
                            && request.resource.data.street is string
                            && request.resource.data.street.size() > 0
                            && request.resource.data.street.size() <= 100
                            && request.resource.data.houseNumber is string
                            && request.resource.data.houseNumber.size() <= 20
                            && request.resource.data.postcode is string
                            && request.resource.data.postcode.size() > 0
                            && request.resource.data.postcode.size() <= 10
                            && request.resource.data.municipality is string
                            && request.resource.data.municipality.size() > 0
                            && request.resource.data.municipality.size() <= 100
                            && request.resource.data.latitude is number
                            && request.resource.data.latitude >= -90
                            && request.resource.data.latitude <= 90
                            && request.resource.data.longitude is number
                            && request.resource.data.longitude >= -180
                            && request.resource.data.longitude <= 180;

      allow delete: if isMerchant() && isOwner(shopId);
    }

    // Helper: true when the data of a package has the right shape. Prices are whole cents.
    // The times are "HH:mm" and the date is "yyyy-MM-dd"; "HH:mm" strings compare in the right order.
    // The photo (photoBase64, a JPEG in Base64) is optional and at most 500 000 characters, so the
    // document stays far under the limit of 1 MiB of Firestore (same limit as in the app).
    function isValidPackage(data) {
      return data.keys().hasOnly(['ownerId', 'shopId', 'title', 'description', 'priceCents',
                                  'originalPriceCents', 'quantity', 'pickupDate', 'pickupFrom',
                                  'pickupTo', 'visible', 'createdAt', 'photoBase64'])
             && (!('photoBase64' in data)
                 || (data.photoBase64 is string
                     && data.photoBase64.size() > 0
                     && data.photoBase64.size() <= 500000))
             && data.title is string
             && data.title.size() > 0
             && data.title.size() <= 60
             && data.description is string
             && data.description.size() <= 500
             && data.priceCents is int
             && data.priceCents > 0
             && data.originalPriceCents is int
             && data.priceCents < data.originalPriceCents
             && data.originalPriceCents <= 100000
             && data.quantity is int
             && data.quantity >= 1
             && data.quantity <= 999
             && data.pickupDate is string
             && data.pickupDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
             && data.pickupFrom is string
             && data.pickupFrom.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
             && data.pickupTo is string
             && data.pickupTo.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
             && data.pickupFrom < data.pickupTo
             && data.visible is bool;
    }

    // Packages: one document per package, with the uid of the merchant as ownerId (and shopId,
    // because the shop of a merchant is stored under their uid).
    match /packages/{packageId} {
      // A customer can see all packages (they look for packages). A merchant can only see their own:
      // the packages of other shops are no business of theirs.
      allow read: if isCustomer()
                  || (isMerchant() && resource.data.ownerId == request.auth.uid);

      // Only a merchant can create a package, for their own shop, with a server time as createdAt.
      allow create: if isMerchant()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.shopId == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && isValidPackage(request.resource.data);

      // Only the owner can change a package, and not who owns it or when it was made.
      allow update: if isMerchant()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.shopId == resource.data.shopId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && isValidPackage(request.resource.data);

      allow delete: if isMerchant() && resource.data.ownerId == request.auth.uid;
    }

    // Everything else is denied by default (no other match blocks grant access).
  }
}
